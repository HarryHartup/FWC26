};

function getC(team){ return TC[team]||null; }

function luminance(hex){
  const r=parseInt(hex.slice(1,3),16)/255,g=parseInt(hex.slice(3,5),16)/255,b=parseInt(hex.slice(5,7),16)/255;
  const toL=c=>c<=0.03928?c/12.92:Math.pow((c+0.055)/1.055,2.4);
  return 0.2126*toL(r)+0.7152*toL(g)+0.0722*toL(b);
}
function textOn(hex){ return luminance(hex)>0.35?'#111':'#fff'; }

function initials(name){
  if(!name||name==='TBC'||name==='-') return '';
  return name.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
}

let toastTimer;
function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer=setTimeout(()=>t.classList.remove('show'),1800);
}

function copyText(text){
  navigator.clipboard.writeText(text).then(()=>showToast('Copied: '+text)).catch(()=>{
    const ta=document.createElement('textarea'); ta.value=text;
    document.body.appendChild(ta); ta.select(); document.execCommand('copy');
    document.body.removeChild(ta); showToast('Copied: '+text);
  });
}

// Team chip: home kit = top half, away = bottom half circle
function teamChip(name, isHome){
  if(!name||name==='') return '<span class="dash">-</span>';
  if(name==='TBC') return '<span class="tbc">TBC</span>';
  const cols=getC(name);
  let kit='';
  if(cols){
    const kitColour = isHome ? cols[0] : cols[1];
    const accentColour = isHome ? cols[1] : cols[0];
    const fg=textOn(kitColour);
    const inits=initials(name);
    kit=`<div class="chip-kit" style="background:${kitColour};color:${fg};">
      <div class="chip-kit-inner" style="background:${accentColour};opacity:0.5;"></div>
      <span style="position:relative;z-index:1;font-size:9px;">${inits}</span>
    </div>`;
  }
  const bgColour = cols ? (isHome ? cols[0]+'22' : cols[1]+'22') : 'rgba(255,255,255,0.04)';
  const borderColour = cols ? (isHome ? cols[0]+'55' : cols[1]+'55') : 'rgba(255,255,255,0.08)';
  return `<span class="team-chip" style="background:${bgColour};border-color:${borderColour};"
    onclick="copyText('${name.replace(/'/g,"\\'")}')">
    ${kit}
    <span class="chip-name">${name}</span>
    <span class="chip-copy">⎘</span>
  </span>`;
}

function roundBadge(r){
  const m={'Group Stage':['round-group','GRP'],'Round of 32':['round-r32','R32'],
    'Round of 16':['round-r16','R16'],'Quarterfinals':['round-qf','QF'],
    'Semifinal':['round-sf','SF'],'Third Place Playoff':['round-3p','3RD'],'Final':['round-f','FINAL']};
  const [cls,lbl]=m[r]||['round-group',r];
  return `<span class="round-badge ${cls}">${lbl}</span>`;
}

function val(v){ if(!v||v.trim()==='') return '<span class="dash">-</span>'; return v; }

