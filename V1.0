<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FIFA World Cup 2026 — Broadcast Hub</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --fifa-red: #DA291C;
    --fifa-blue: #003DA5;
    --fifa-gold: #F5A623;
    --fifa-green: #009A44;
    --fifa-purple: #7B2D8B;
    --dark: #080B16;
    --dark2: #0F1220;
    --dark3: #161B2E;
    --panel: #1A2038;
    --border: rgba(255,255,255,0.08);
    --text: #F0F2FF;
    --muted: #8892AA;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--dark); color: var(--text); font-family: 'Barlow', sans-serif; font-size: 14px; min-height: 100vh; }

  /* RAINBOW STRIPES */
  .rainbow-top {
    height: 5px;
    background: linear-gradient(90deg,#E50011 0%,#FF6B00 14%,#FFD100 28%,#009A44 42%,#003DA5 57%,#7B2D8B 71%,#DA291C 85%,#FF6B00 100%);
    background-size: 200% 100%;
    animation: rainbowScroll 4s linear infinite;
  }
  @keyframes rainbowScroll { 0%{background-position:0% 0%} 100%{background-position:-200% 0%} }

  .rainbow-divider {
    height: 2px;
    background: linear-gradient(90deg,#E50011,#FF6B00,#FFD100,#009A44,#003DA5,#7B2D8B,#E50011);
    opacity: 0.6;
  }

  /* HEADER */
  .header {
    background: linear-gradient(135deg,#001A6E 0%,#000D3D 50%,#0A0210 100%);
    padding: 0 24px;
    position: sticky; top: 5px; z-index: 100;
    display: flex; align-items: center; gap: 20px; height: 58px;
  }
  .header-logo {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900; font-size: 23px; letter-spacing: 3px;
    color: #fff; text-transform: uppercase; white-space: nowrap;
  }
  .header-logo .cup { color: var(--fifa-gold); }
  .header-logo .year {
    background: linear-gradient(90deg,#E50011,#FF6B00,#FFD100,#009A44,#003DA5,#7B2D8B);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    font-size: 26px;
  }
  .header-divider { width: 1px; height: 32px; background: rgba(255,255,255,0.15); }
  .header-sub { font-family:'Barlow Condensed',sans-serif; font-size:12px; letter-spacing:3px; color:var(--muted); text-transform:uppercase; }
  .header-right { margin-left:auto; display:flex; gap:10px; align-items:center; }

  .btn {
    font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:13px;
    letter-spacing:1.5px; text-transform:uppercase; padding:8px 18px;
    border-radius:4px; border:none; cursor:pointer; text-decoration:none;
    display:inline-flex; align-items:center; gap:6px; transition:all 0.15s;
  }
  .btn-gold { background:var(--fifa-gold); color:#000; }
  .btn-gold:hover { filter:brightness(1.1); transform:translateY(-1px); }
  .btn-outline { background:transparent; color:var(--text); border:1px solid rgba(255,255,255,0.2); }
  .btn-outline:hover { background:rgba(255,255,255,0.07); }

  /* STAT BAR */
  .stat-bar {
    background: linear-gradient(90deg,#0D1228,#111830,#0D1228);
    border-bottom: 1px solid var(--border);
    padding: 10px 24px;
    display: flex; gap: 28px; align-items: center; overflow-x: auto;
  }
  .stat-item { display:flex; flex-direction:column; gap:2px; min-width:72px; }
  .stat-label { font-size:9px; letter-spacing:2.5px; text-transform:uppercase; color:var(--muted); }
  .stat-value { font-family:'Barlow Condensed',sans-serif; font-size:24px; font-weight:900; color:var(--text); }
  .sv-rainbow {
    background: linear-gradient(90deg,#FFD100,#FF6B00,#E50011);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
  }
  .sv-blue { color:#5B9EFF; }
  .sv-green { color:#3DE090; }
  .sv-purple { color:#C97EFF; }
  .sv-red { color:#FF6B6B; }
  .stat-divider { width:1px; height:36px; background:var(--border); flex-shrink:0; }

  /* FILTERS */
  .filters {
    background: var(--dark2); border-bottom:1px solid var(--border);
    padding:12px 24px; display:flex; gap:12px; flex-wrap:wrap; align-items:center;
  }
  .filter-label { font-size:10px; letter-spacing:2px; text-transform:uppercase; color:var(--muted); }
  select, input[type="text"] {
    background:var(--panel); border:1px solid var(--border); color:var(--text);
    padding:7px 12px; border-radius:4px; font-family:'Barlow',sans-serif; font-size:13px; outline:none; cursor:pointer;
  }
  select:focus, input[type="text"]:focus { border-color:var(--fifa-gold); box-shadow:0 0 0 2px rgba(245,166,35,0.15); }
  input[type="text"] { min-width:200px; }
  .filter-group { display:flex; align-items:center; gap:8px; }

  /* TABS */
  .tabs { display:flex; gap:4px; padding:20px 24px 0; background:var(--dark); }
  .tab {
    font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:13px;
    letter-spacing:2px; text-transform:uppercase; padding:10px 22px;
    border-radius:6px 6px 0 0; border:1px solid transparent; border-bottom:none;
    cursor:pointer; color:var(--muted); background:transparent; transition:all 0.15s;
  }
  .tab:hover { color:var(--text); }
  .tab.active {
    background:var(--dark2); border-color:var(--border); color:var(--fifa-gold);
    border-bottom-color:var(--dark2);
  }
  .tab-content { display:none; }
  .tab-content.active { display:block; }

  /* MAIN */
  .main { padding:24px; }

  /* TABLE WRAPPER */
  .table-wrapper {
    background:var(--dark2); border:1px solid var(--border); border-radius:8px;
    overflow:hidden; overflow-x:auto;
  }
  .table-header-row {
    display:flex; align-items:center; padding:14px 20px;
    border-bottom:1px solid var(--border); background:var(--panel); gap:12px;
  }
  .table-title {
    font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:15px;
    letter-spacing:2px; text-transform:uppercase; color:var(--text);
  }
  .record-count {
    font-size:12px; padding:3px 12px; background:rgba(245,166,35,0.12);
    color:var(--fifa-gold); border-radius:20px; font-weight:600; margin-left:auto;
    border:1px solid rgba(245,166,35,0.25);
  }

  table { width:100%; border-collapse:collapse; font-size:13px; min-width:1300px; }
  thead { position:sticky; top:0; z-index:10; }
  th {
    background:#0C1022; color:var(--muted);
    font-family:'Barlow Condensed',sans-serif; font-size:10px; font-weight:700;
    letter-spacing:2px; text-transform:uppercase; padding:10px 12px;
    text-align:left; border-bottom:2px solid var(--border);
    white-space:nowrap; cursor:pointer; user-select:none;
  }
  th:hover { color:var(--fifa-gold); }
  th.sorted { color:var(--fifa-gold); }

  td { padding:9px 12px; border-bottom:1px solid rgba(255,255,255,0.04); vertical-align:middle; white-space:nowrap; }
  tr:last-child td { border-bottom:none; }
  tr:hover td { background:rgba(255,255,255,0.025); }

  .match-num { font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:16px; color:var(--fifa-gold); }
  .date-cell { color:var(--muted); font-size:12px; }
  .venue-cell { color:var(--text); }
  .trigram {
    font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:13px;
    letter-spacing:1px; color:#fff; background:var(--panel);
    padding:3px 8px; border-radius:3px; border:1px solid var(--border);
  }
  .time-cell { font-family:'Barlow Condensed',sans-serif; font-size:14px; font-weight:600; }
  .contrib-cell { font-family:'Barlow Condensed',sans-serif; font-weight:600; font-size:13px; color:var(--muted); }
  .dash { color:rgba(255,255,255,0.2); }
  .tbc { color:var(--muted); font-style:italic; }

  /* ROUND BADGES */
  .round-badge {
    font-family:'Barlow Condensed',sans-serif; font-size:11px; font-weight:700;
    letter-spacing:1px; text-transform:uppercase; padding:3px 8px; border-radius:3px; white-space:nowrap;
  }
  .round-group { background:rgba(0,61,165,0.25); color:#7EB8FF; border:1px solid rgba(0,61,165,0.4); }
  .round-r32   { background:rgba(0,154,68,0.2);  color:#5CE8A0; border:1px solid rgba(0,154,68,0.35); }
  .round-r16   { background:rgba(123,45,139,0.25);color:#CC88E8; border:1px solid rgba(123,45,139,0.4); }
  .round-qf    { background:rgba(218,41,28,0.2);  color:#FF8880; border:1px solid rgba(218,41,28,0.4); }
  .round-sf    { background:rgba(245,166,35,0.2); color:#FFD580; border:1px solid rgba(245,166,35,0.4); }
  .round-f     { background:rgba(245,166,35,0.35);color:var(--fifa-gold); border:1px solid var(--fifa-gold); }
  .round-3p    { background:rgba(180,180,180,0.12);color:#C0C0C0; border:1px solid rgba(180,180,180,0.25); }

  /* TEAM CHIP — hoverable + copy */
  .team-chip {
    display:inline-flex; align-items:center; gap:8px;
    padding:4px 10px 4px 5px; border-radius:20px;
    border:1px solid transparent;
    cursor:pointer; transition:all 0.18s; position:relative;
    min-width:140px;
  }
  .team-chip:hover { border-color:rgba(255,255,255,0.2); filter:brightness(1.15); transform:translateY(-1px); }
  .team-chip:hover .chip-copy { opacity:1; }
  .team-chip:active { transform:scale(0.97); }

  .chip-kit {
    width:28px; height:28px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0; font-family:'Barlow Condensed',sans-serif;
    font-weight:900; font-size:10px; letter-spacing:0.5px;
    border:2px solid rgba(255,255,255,0.15);
    position:relative; overflow:hidden;
  }
  .chip-kit-inner {
    position:absolute; bottom:0; left:0; right:0; height:50%;
  }
  .chip-name { font-weight:500; font-size:13px; flex:1; }
  .chip-copy {
    opacity:0; font-size:10px; color:rgba(255,255,255,0.5);
    transition:opacity 0.15s; flex-shrink:0;
  }

  /* COPY TOAST */
  .toast {
    position:fixed; bottom:28px; left:50%; transform:translateX(-50%) translateY(20px);
    background:#1a2540; border:1px solid var(--border);
    border-left:3px solid var(--fifa-gold);
    color:var(--text); padding:10px 20px; border-radius:6px;
    font-family:'Barlow Condensed',sans-serif; font-size:14px; font-weight:600; letter-spacing:1px;
    opacity:0; transition:all 0.25s; z-index:9999; white-space:nowrap;
    pointer-events:none;
  }
  .toast.show { opacity:1; transform:translateX(-50%) translateY(0); }

  /* OPERATOR PILL */
  .op-pill {
    font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:12px;
    letter-spacing:0.5px; padding:3px 10px; border-radius:20px; white-space:nowrap;
  }
  .op-alex  { background:rgba(0,154,68,0.18);  color:#4DE09A; border:1px solid rgba(0,154,68,0.35); }
  .op-jake  { background:rgba(0,61,165,0.22);  color:#7EB8FF; border:1px solid rgba(0,61,165,0.4); }
  .op-harry { background:rgba(123,45,139,0.22);color:#CC88E8; border:1px solid rgba(123,45,139,0.4); }

  /* COLOURS PANEL */
  .colours-panel { background:var(--dark2); border:1px solid var(--border); border-radius:8px; overflow:hidden; }
  .colours-header { padding:14px 20px; border-bottom:1px solid var(--border); background:var(--panel); display:flex; align-items:center; gap:12px; }
  .colours-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:1px; background:rgba(255,255,255,0.04); }
  .colour-card {
    background:var(--dark2); padding:14px 16px;
    display:flex; align-items:center; gap:12px; cursor:pointer;
    transition:background 0.15s;
  }
  .colour-card:hover { background:var(--dark3); }

  /* Large swatch with hover copy */
  .kit-swatch-wrap {
    display:flex; gap:4px; flex-shrink:0;
  }
  .kit-swatch {
    width:30px; height:44px; border-radius:4px;
    border:1px solid rgba(255,255,255,0.1);
    position:relative; cursor:pointer; overflow:hidden;
    transition:all 0.18s;
  }
  .kit-swatch:hover { transform:scale(1.12) translateY(-2px); border-color:rgba(255,255,255,0.35); z-index:2; }
  .kit-swatch .swatch-label {
    position:absolute; bottom:0; left:0; right:0;
    text-align:center; font-size:7px; font-weight:700; letter-spacing:0.5px;
    padding:2px 0;
    opacity:0; transition:opacity 0.15s;
  }
  .kit-swatch:hover .swatch-label { opacity:1; }
  .colour-team-name { font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:15px; color:var(--text); }
  .colour-codes { font-size:11px; color:var(--muted); margin-top:3px; display:flex; gap:8px; flex-wrap:wrap; }
  .hex-copy {
    font-family:'Barlow Condensed',sans-serif; font-size:11px;
    padding:2px 6px; border-radius:3px; cursor:pointer;
    border:1px solid var(--border); background:var(--panel);
    color:var(--muted); transition:all 0.15s; letter-spacing:0.5px;
    display:inline-flex; align-items:center; gap:3px;
  }
  .hex-copy:hover { color:var(--text); border-color:rgba(255,255,255,0.25); }

  /* LEGEND */
  .legend-row {
    display:flex; gap:16px; flex-wrap:wrap; align-items:center;
    padding:12px 20px; border-top:1px solid var(--border); background:var(--dark2);
  }
  .legend-item { display:flex; align-items:center; gap:6px; font-size:11px; color:var(--muted); }

  /* FOOTER */
  .footer {
    margin-top:24px; padding:16px 24px; border-top:1px solid var(--border);
    display:flex; justify-content:space-between; align-items:center;
    font-size:12px; color:var(--muted);
  }

  .empty-state { text-align:center; padding:60px 20px; color:var(--muted); }
  .empty-state .big { font-family:'Barlow Condensed',sans-serif; font-size:48px; font-weight:900; color:rgba(255,255,255,0.05); margin-bottom:12px; }

  /* HEADER rainbow accent line */
  .header-accent {
    height:2px;
    background:linear-gradient(90deg,transparent,#E50011,#FFD100,#009A44,#003DA5,#7B2D8B,transparent);
  }

  /* Scrollbar */
  ::-webkit-scrollbar { width:6px; height:6px; }
  ::-webkit-scrollbar-track { background:var(--dark); }
  ::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.12); border-radius:3px; }
  ::-webkit-scrollbar-thumb:hover { background:rgba(255,255,255,0.22); }
</style>
</head>
<body>

<div class="rainbow-top"></div>

<header class="header">
  <div class="header-logo">
    FIFA <span class="cup">World Cup</span> <span class="year">2026</span>
  </div>
  <div class="header-divider"></div>
  <div class="header-sub">Harry's FWC26 Database</div>
  <div class="header-right">
    <a class="btn btn-gold" href="https://docs.google.com/spreadsheets/d/1FSXt6UdEyqFUD-4b9sZ67yOOTcfNW2HVzsSpNW1qx8Y/edit?gid=0#gid=0" target="_blank">
      ⚽ Player Match JSON
    </a>
  </div>
</header>
<div class="header-accent"></div>

<div class="stat-bar">
  <div class="stat-item">
    <div class="stat-label">Total Matches</div>
    <div class="stat-value sv-rainbow" id="totalMatches">104</div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <div class="stat-label">Group Stage</div>
    <div class="stat-value sv-blue" id="gsCount">72</div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <div class="stat-label">Knockout</div>
    <div class="stat-value sv-green" id="koCount">32</div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <div class="stat-label">Teams</div>
    <div class="stat-value sv-purple">48</div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <div class="stat-label">Venues</div>
    <div class="stat-value">16</div>
  </div>
  <div class="stat-divider"></div>
  <div class="stat-item">
    <div class="stat-label">Showing</div>
    <div class="stat-value sv-red" id="showingCount">104</div>
  </div>
</div>

<div class="tabs">
  <button class="tab active" onclick="switchTab('matches',this)">Match Schedule</button>
  <button class="tab" onclick="switchTab('colours',this)">Team Colours</button>
</div>

<div class="filters" id="matchFilters">
  <div class="filter-group">
    <span class="filter-label">Search</span>
    <input type="text" id="searchInput" placeholder="Team, venue, match…" oninput="applyFilters()">
  </div>
  <div class="filter-group">
    <span class="filter-label">Round</span>
    <select id="roundFilter" onchange="applyFilters()">
      <option value="">All Rounds</option>
      <option>Group Stage</option>
      <option>Round of 32</option>
      <option>Round of 16</option>
      <option>Quarterfinals</option>
      <option>Semifinal</option>
      <option>Third Place Playoff</option>
      <option>Final</option>
    </select>
  </div>
  <div class="filter-group">
    <span class="filter-label">Venue</span>
    <select id="venueFilter" onchange="applyFilters()"><option value="">All Venues</option></select>
  </div>
  <div class="filter-group">
    <span class="filter-label">Date</span>
    <select id="dateFilter" onchange="applyFilters()"><option value="">All Dates</option></select>
  </div>
  <button class="btn btn-outline" onclick="clearFilters()" style="margin-left:auto;">✕ Clear</button>
</div>

<div class="main">
  <div id="matchesTab" class="tab-content active">
    <div class="table-wrapper">
      <div class="table-header-row">
        <div class="table-title">Match Schedule</div>
        <div class="record-count" id="recordCount">104 matches</div>
      </div>
      <table id="matchTable">
        <thead>
          <tr>
            <th onclick="sortTable(0)">#</th>
            <th onclick="sortTable(1)">Date</th>
            <th onclick="sortTable(2)">Venue</th>
            <th>TGM</th>
            <th>KO IBC</th>
            <th>KO Local</th>
            <th onclick="sortTable(6)">Round</th>
            <th>Team A <span style="color:rgba(255,255,255,0.25);font-weight:400">(Home)</span></th>
            <th>Team B <span style="color:rgba(255,255,255,0.25);font-weight:400">(Away)</span></th>
            <th>Contrib</th>
            <th>Distrib</th>
            <th>HawkVR Op</th>
            <th>Station</th>
            <th>VOR/Stn</th>
            <th>VTG</th>
            <th>SAO OP</th>
            <th>Tracking Sup</th>
          </tr>
        </thead>
        <tbody id="matchBody"></tbody>
      </table>
      <div class="legend-row">
        <span class="legend-item"><span class="round-badge round-group">GRP</span> Group Stage</span>
        <span class="legend-item"><span class="round-badge round-r32">R32</span> Round of 32</span>
        <span class="legend-item"><span class="round-badge round-r16">R16</span> Round of 16</span>
        <span class="legend-item"><span class="round-badge round-qf">QF</span> Quarterfinals</span>
        <span class="legend-item"><span class="round-badge round-sf">SF</span> Semifinal</span>
        <span class="legend-item"><span class="round-badge round-f">F</span> Final</span>
        <span style="margin-left:auto;font-size:11px;color:var(--muted)">Click any team chip to copy name • Hover hex to copy colour</span>
      </div>
    </div>
  </div>

  <div id="coloursTab" class="tab-content">
    <div class="colours-panel">
      <div class="colours-header">
        <div class="table-title">Team Kit Colours</div>
        <div class="record-count">48 nations — hover swatch or hex to copy</div>
      </div>
      <div class="colours-grid" id="coloursGrid"></div>
    </div>
  </div>
</div>

<footer class="footer">
  <span>FIFA World Cup 2026 &nbsp;·&nbsp; USA · Canada · Mexico &nbsp;·&nbsp; Broadcast Operations</span>
  <span id="footerDate"></span>
</footer>

<div class="toast" id="toast"></div>

<script>
const TC = {
  "Algeria":["#FFFFFF","#006633"],
  "Argentina":["#6CACE4","#3A76CB"],
  "Australia":["#FFCD00","#1F5A5C"],
  "Austria":["#EF3340","#FFFFFF"],
  "Belgium":["#E30613","#A0D7F0"],
  "Bosnia & Herzegovina":["#002F6C","#FFFFFF"],
  "Brazil":["#FFDC02","#193375"],
  "Cabo Verde":["#003DA5","#FFFFFF"],
  "Canada":["#C5281C","#4D4D4D"],
  "Colombia":["#FFCD00","#0B1B3D"],
  "Congo DR":["#0085CA","#FFFFFF"],
  "Côte d'Ivoire":["#FF8100","#FFFFFF"],
  "Croatia":["#ED1C24","#005DAA"],
  "Curaçao":["#002B7F","#FDFBF7"],
  "Czechia":["#65101F","#FFFFFF"],
  "Ecuador":["#FFD100","#002255"],
  "Egypt":["#C8102E","#FFFFFF"],
  "England":["#FFFFFF","#EA1F29"],
  "France":["#21304D","#B3E2D8"],
  "Germany":["#FFFFFF","#031633"],
  "Ghana":["#FFFFFF","#FCD116"],
  "Haiti":["#00209F","#FFFFFF"],
  "IR Iran":["#FFFFFF","#DA0000"],
  "Iraq":["#FFFFFF","#007A3D"],
  "Japan":["#000555","#F6F6F6"],
  "Jordan":["#FFFFFF","#E63B3B"],
  "Korea Republic":["#EC0F32","#5C34DC"],
  "Mexico":["#00933B","#FFFFFF"],
  "Morocco":["#E50011","#FFFFFF"],
