const OPERATORS=["Alex Hithersay","Jake Jones","Alex Hithersay","Harry Hartup","Alex Hithersay","Alex Hithersay","Harry Hartup","Jake Jones","Alex Hithersay","Alex Hithersay","Jake Jones","Jake Jones","Harry Hartup","Harry Hartup","Jake Jones","Jake Jones","Jake Jones","Jake Jones","Alex Hithersay","Alex Hithersay","Harry Hartup","Alex Hithersay","Harry Hartup","Alex Hithersay","Jake Jones","Jake Jones","Harry Hartup","Harry Hartup","Alex Hithersay","Alex Hithersay","Jake Jones","Jake Jones","Harry Hartup","Harry Hartup","Alex Hithersay","Alex Hithersay","Jake Jones","Jake Jones","Harry Hartup","Harry Hartup","Alex Hithersay","Alex Hithersay","Jake Jones","Jake Jones","Harry Hartup","Harry Hartup","Alex Hithersay","Alex Hithersay","Alex Hithersay","Harry Hartup","Alex Hithersay","Jake Jones","Harry Hartup","Jake Jones","Harry Hartup","Jake Jones","Harry Hartup","Alex Hithersay","Alex Hithersay","Jake Jones","Alex Hithersay","Harry Hartup","Jake Jones","Alex Hithersay","Harry Hartup","Jake Jones","Jake Jones","Harry Hartup","Alex Hithersay","Jake Jones","Harry Hartup","Alex Hithersay","Jake Jones"];

const STATIONS=[1,2,1,2,1,2,3,1,1,2,3,1,1,2,3,1,1,2,3,1,1,2,3,1,1,2,3,1,1,2,3,1,1,2,3,1,1,2,3,1,1,2,3,1,1,2,3,1,1,2,3,1,2,3,1,2,3,1,2,3,1,2,3,1,2,3,1,2,3,1,2,3,1];

function opCell(name){
  if(!name) return '<span class="dash">-</span>';
  const first=name.split(' ')[0];
  const cls=first==='Alex'?'op-alex':first==='Jake'?'op-jake':'op-harry';
  return `<span class="op-pill ${cls}" title="${name}">${first}</span>`;
}

function stationCell(n){
  if(!n) return '<span class="dash">-</span>';
  const cols={1:'#FF6B00',2:'#003DA5',3:'#009A44'};
  const c=cols[n]||'#888';
  return `<span style="font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:16px;color:${c};">${n}</span>`;
}

const matchData=[...matches];
let filteredData=[...matchData];
let sortCol=0,sortDir=1;

function buildTable(data){
  const tbody=document.getElementById('matchBody');
  if(!data.length){
    tbody.innerHTML=`<tr><td colspan="17"><div class="empty-state"><div class="big">⚽</div><p>No matches found.</p></div></td></tr>`;
    document.getElementById('recordCount').textContent='0 matches';
    document.getElementById('showingCount').textContent='0';
    return;
  }
  document.getElementById('recordCount').textContent=data.length+' matches';
  document.getElementById('showingCount').textContent=data.length;
  tbody.innerHTML=data.map((m,i)=>{
    const [num,date,venue,tgm,koIBC,koLocal,round,teamA,teamB,contrib,distrib,vor]=m;
    const origIdx=matchData.indexOf(m);
    const op=OPERATORS[origIdx]||'';
    const stn=STATIONS[origIdx]||'';
    return `<tr>
      <td><span class="match-num">${num}</span></td>
      <td><span class="date-cell">${val(date)}</span></td>
      <td><span class="venue-cell">${val(venue)}</span></td>
      <td><span class="trigram">${val(tgm)}</span></td>
      <td><span class="time-cell">${val(koIBC)}</span></td>
      <td><span class="time-cell" style="color:var(--muted)">${val(koLocal)}</span></td>
      <td>${roundBadge(round)}</td>
      <td>${teamChip(teamA,true)}</td>
      <td>${teamChip(teamB,false)}</td>
      <td><span class="contrib-cell">${contrib||'-'}</span></td>
      <td><span class="contrib-cell">${distrib||'-'}</span></td>
      <td>${opCell(op)}</td>
      <td>${stationCell(stn)}</td>
      <td><span class="contrib-cell">${vor||'-'}</span></td>
      <td><span class="dash">-</span></td>
      <td><span class="dash">-</span></td>
      <td><span class="dash">-</span></td>
    </tr>`;
  }).join('');
}

function buildColours(){
  const grid=document.getElementById('coloursGrid');
  const teams=Object.keys(TC).filter(t=>t!=='United States'&&t!=='USA').concat(['USA']).sort((a,b)=>a.localeCompare(b));
  const seen=new Set();
  grid.innerHTML=teams.filter(t=>{if(seen.has(t))return false;seen.add(t);return true;}).map(t=>{
    const [home,away]=TC[t];
    const homeFg=textOn(home); const awayFg=textOn(away);
    return `<div class="colour-card">
      <div class="kit-swatch-wrap">
        <div class="kit-swatch" style="background:${home}" onclick="copyText('${home}')" title="Click to copy ${home}">
          <span class="swatch-label" style="background:rgba(0,0,0,0.55);color:#fff;">HOME</span>
        </div>
        <div class="kit-swatch" style="background:${away}" onclick="copyText('${away}')" title="Click to copy ${away}">
          <span class="swatch-label" style="background:rgba(0,0,0,0.55);color:#fff;">AWAY</span>
        </div>
      </div>
      <div style="flex:1;min-width:0">
        <div class="colour-team-name">${t}</div>
        <div class="colour-codes">
          <span class="hex-copy" onclick="copyText('${home}')">
            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${home};border:1px solid rgba(255,255,255,0.2);vertical-align:middle;"></span>
            ${home}
          </span>
          <span class="hex-copy" onclick="copyText('${away}')">
            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${away};border:1px solid rgba(255,255,255,0.2);vertical-align:middle;"></span>
            ${away}
          </span>
        </div>
      </div>
    </div>`;
  }).join('');
}

function populateFilters(){
  const venues=[...new Set(matchData.map(m=>m[2]))].sort();
  const dates=[...new Set(matchData.map(m=>m[1]))].sort();
  const vs=document.getElementById('venueFilter'), ds=document.getElementById('dateFilter');
  venues.forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v;vs.appendChild(o);});
  dates.forEach(d=>{const o=document.createElement('option');o.value=d;o.textContent=d;ds.appendChild(o);});
}

function applyFilters(){
  const search=document.getElementById('searchInput').value.toLowerCase();
  const round=document.getElementById('roundFilter').value;
  const venue=document.getElementById('venueFilter').value;
  const date=document.getElementById('dateFilter').value;
  filteredData=matchData.filter(m=>{
    const [num,dt,vn,tgm,koIBC,koLocal,rd,tA,tB]=m;
    if(round&&rd!==round)return false;
    if(venue&&vn!==venue)return false;
    if(date&&dt!==date)return false;
    if(search){const s=[num,dt,vn,tgm,koIBC,rd,tA,tB].join(' ').toLowerCase();if(!s.includes(search))return false;}
    return true;
  });
  buildTable(filteredData);
}

function clearFilters(){
  document.getElementById('searchInput').value='';
  document.getElementById('roundFilter').value='';
  document.getElementById('venueFilter').value='';
  document.getElementById('dateFilter').value='';
  filteredData=[...matchData];
  buildTable(filteredData);
}

function sortTable(col){
  if(sortCol===col)sortDir*=-1; else{sortCol=col;sortDir=1;}
  filteredData.sort((a,b)=>(a[col]||'').localeCompare(b[col]||'')*sortDir);
  buildTable(filteredData);
}

function switchTab(name,el){
  document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  document.getElementById(name+'Tab').classList.add('active');
  document.getElementById('matchFilters').style.display=name==='matches'?'flex':'none';
}

function updateStats(){
  const gs=matchData.filter(m=>m[6]==='Group Stage').length;
  const ko=matchData.filter(m=>m[6]!=='Group Stage').length;
  document.getElementById('gsCount').textContent=gs;
  document.getElementById('koCount').textContent=ko;
  document.getElementById('totalMatches').textContent=matchData.length;
  document.getElementById('showingCount').textContent=matchData.length;
}

document.getElementById('footerDate').textContent='Updated '+new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
populateFilters(); buildTable(matchData); buildColours(); updateStats();
</script>
</body>
</html>
